{
  // The schema is generated by the linter and tracked beside this file: the tool is not published to
  // a package registry, so there is no dependency copy to point at. Regenerate it with the linter's
  // `schema` command whenever the linter itself is upgraded.
  "$schema": "./wastech-mdlint.schema.json",

  "include": [
    "./*.md", // anchored on purpose: the repository's own root documents, not every README in the tree
    ".agents/**/*.md", // the mandatory rules every coding agent reads
    ".claude/skills/**/*.md", // agent workflows: context the harness loads verbatim
    "docs/**/*.md" // the task queue and, later, the connector's own documentation
  ],

  "exclude": [],

  // Every rule below reports ZERO over this corpus today, so any output at all means a new problem
  // rather than an old one. A rule is added only once it measures zero and only when it guards an
  // invariant this repository actually has.
  "rules": [
    // Relative links resolve; anchors match a real heading; image targets resolve.
    { "rule": "REF-001" },
    { "rule": "REF-002" },
    { "rule": "REF-003" },

    // No reference cycle spanning three or more documents.
    { "rule": "GRP-001" },

    // Every document is reachable from another one. An error rather than advice: a queue item nothing
    // links to is an item nobody picks up.
    {
      "rule": "GRP-002",
      "severity": "error",
      "options": {
        // Agent skills are discovered by their directory, not by links, so orphanhood carries no
        // signal there.
        "exclude": [".claude/skills/**"]
      }
    },

    // Per-file size budgets, as ratchets: tighten a number as its class shrinks; never raise one to
    // silence a finding.
    {
      "rule": "SIZE-001",
      "options": {
        "overrides": [
          {
            // Working queue documents, the loosest class: written once, implemented from, removed.
            "pattern": "docs/backlog/**",
            "tokens": { "warn": 26000, "error": 32000 }
          }
        ],
        // Everything else is agent-facing context — the root documents, the rules, the skills — where
        // size is a direct tax on every run.
        "tokens": { "warn": 7000, "error": 9000 }
      }
    },

    // The eager-import budget for what an agent loads before it reads a single line of code.
    {
      "rule": "LLM-001",
      "severity": "error",
      "options": {
        "entrypoints": ["./CLAUDE.md", "./AGENTS.md"],
        "maxTokensPerEntrypoint": 3000
      }
    },

    // Sections that are empty or hold nothing but a placeholder (advisory).
    { "rule": "CTX-001" }
  ]
}
